<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/renderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/renderWebView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#CC11151B"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:id="@+id/renderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menyiapkan GPU VirtualDisplay renderer..."
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/renderQueueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Queue"
            android:textColor="#BFD8DC"
            android:textSize="11sp" />
        <Button
            android:id="@+id/backgroundButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:text="Jalankan di background"
            android:textAllCaps="false"
            android:textSize="11sp" />
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:text="Batalkan"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
